# Copy to .env and adjust as needed. All are optional — sensible defaults apply.

# Port the companion server listens on (dashboard + WebSocket).
DECKBOARD_PORT=8787

# OBS Studio's WebSocket server (Tools > WebSocket Server Settings in OBS).
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Set to "1" to auto-switch the active page based on the frontmost app on
# startup (macOS only). Name a page after the app (e.g. "Safari") to match it.
# Can also be toggled live from the dashboard's Settings tab.
DECKBOARD_APP_PROFILES=0
